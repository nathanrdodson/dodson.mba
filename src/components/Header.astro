---
import HeaderSearch from './HeaderSearch.astro';

const nav = [
  { label: 'Home', url: '/' },
  { label: 'Experience', url: '/experience/' },
  { label: 'Writing', url: '/blog/' },
  { label: 'Photos', url: '/photos/' },
];

const currentPath = Astro.url.pathname;
---

<header class="m-header js-header">
  <!-- Mobile top bar -->
  <div class="m-mobile-topbar">
    <button class="m-icon-button in-mobile-topbar js-open-menu" aria-label="Open menu">
      <i class="iconoir-menu icon-md" aria-hidden="true"></i>
    </button>
    <a href="/" class="m-site-name in-mobile-topbar" aria-label="Nathan Dodson">
      <img src="/images/logo.png" alt="Nathan Dodson" class="m-site-logo" />
    </a>
    <button
      class="m-icon-button in-mobile-topbar in-search-toggle js-open-menu js-open-search-in-menu"
      aria-label="Open search"
    >
      <span class="iconoir-search" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Full menu -->
  <div class="m-menu js-menu">
    <button class="m-icon-button as-close-menu js-close-menu" aria-label="Close menu">
      <i class="iconoir-xmark icon-xl"></i>
    </button>
    <div class="m-menu__main">
      <div class="l-wrapper">
        <div class="m-nav js-main-nav">
          <nav class="m-nav__left js-main-nav-left" role="navigation" aria-label="Main menu">
            <ul>
              <li class="only-desktop">
                <a href="/" class="m-site-name in-desktop-menu" aria-label="Nathan Dodson">
                  <img src="/images/logo.png" alt="Nathan Dodson" class="m-site-logo" />
                </a>
              </li>

              {nav.map((item) => (
                <li class={currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) ? 'nav-current' : ''}>
                  <a href={item.url}>{item.label}</a>
                </li>
              ))}

            </ul>
          </nav>

          <div class="m-nav__right">
            <HeaderSearch />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
