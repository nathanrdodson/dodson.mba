---
// Editorial home hero — pure typography, no image
---

<section class="home-hero" data-animate="fade">
  <div class="l-wrapper">
    <div class="home-hero__inner">
      <h1 class="home-hero__name">Nathan Dodson</h1>
      <p class="home-hero__title">IT Director &nbsp;&middot;&nbsp; Platform Engineer &nbsp;&middot;&nbsp; MBA</p>
      <div class="home-hero__bio">
        <slot />
      </div>
      <div class="home-hero__social">
        <a href="https://github.com/nathanrdodson" class="home-hero__social-link" aria-label="GitHub" target="_blank" rel="noopener">
          <i class="iconoir-github" aria-hidden="true"></i>
        </a>
        <a href="https://www.letterboxd.com/nathanrdodson" class="home-hero__social-link" aria-label="Letterboxd" target="_blank" rel="noopener">
          <i class="iconoir-movie" aria-hidden="true"></i>
        </a>
        <a href="https://www.stats.fm/nrd" class="home-hero__social-link" aria-label="Stats.fm" target="_blank" rel="noopener">
          <i class="iconoir-music-note" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @import '../styles/common/mixins';
  @import '../styles/common/variables';

  .home-hero {
    padding: 112px 0 80px;
    border-bottom: 1px solid var(--primary-border-color);

    @include respond-to('medium') {
      padding: 160px 0 96px;
    }
  }

  .home-hero__inner {
    max-width: 760px;
  }

  .home-hero__name {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 7vw, 5rem);
    letter-spacing: 0.5px;
    color: var(--primary-foreground-color);
    margin: 0 0 16px;
    line-height: 1.08;
  }

  .home-hero__title {
    font-size: 0.9375rem;
    letter-spacing: 0.3px;
    color: var(--accent-color);
    margin: 0 0 32px;
    font-weight: 400;
  }

  .home-hero__bio {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--titles-color);
    max-width: 560px;
    margin: 0 0 40px;

    :global(p) {
      margin: 0 0 12px;

      &:last-child { margin-bottom: 0; }
    }

    :global(a) {
      color: var(--accent-color);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      @include transition(border-color 0.2s ease);

      &:hover {
        border-bottom-color: var(--accent-color);
      }
    }
  }

  .home-hero__social {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .home-hero__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: 1.25rem;
    color: var(--titles-color);
    text-decoration: none;
    border-radius: 50%;
    @include transition(color 0.2s ease);

    &:hover {
      color: var(--accent-color);
    }
  }
</style>
