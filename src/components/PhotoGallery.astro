---
import type { CollectionEntry } from 'astro:content';

interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
}
---

<div class="pg" id="photo-list">
  {photos.map((photo) => {
    const { title, featureImage, featureImageAlt, date, images } = photo.data;
    const count = images.length;

    return (
      <a href={`/photos/${photo.id}/`} class="pg__item">
        <span class="pg__frame">
          <img src={featureImage} alt={featureImageAlt} loading="lazy" />
        </span>
        <span class="pg__info">
          <span class="pg__title">{title}</span>
          <span class="pg__meta">
            <span>{formatDate(date)}</span>
            {count > 0 && (
              <>
                <span class="pg__meta-sep" aria-hidden="true">/</span>
                <span>{count} photos</span>
              </>
            )}
          </span>
        </span>
      </a>
    );
  })}
</div>

<style lang="scss">
  @import '../styles/common/mixins';
  @import '../styles/common/variables';

  // Photo-first: no surface, no border, no badge. The image is the whole card and the
  // caption sits directly on the paper beneath it.
  .pg {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;

    @include respond-to('medium') {
      grid-template-columns: repeat(2, 1fr);
      gap: 64px 40px;
    }
  }

  .pg__item {
    display: block;

    &:hover .pg__title {
      color: var(--accent-color);
    }
  }

  .pg__frame {
    display: block;
    overflow: hidden;
    background-color: var(--secondary-subtle-color);

    img {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }
  }

  .pg__info {
    display: block;
    padding-top: 16px;
  }

  .pg__title {
    display: block;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--primary-foreground-color);
    margin-bottom: 6px;
    @include transition(color 90ms linear);
  }

  .pg__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--titles-color);
  }

  .pg__meta-sep {
    display: inline-block;
    margin: 0 8px;
    opacity: 0.45;
  }
</style>
