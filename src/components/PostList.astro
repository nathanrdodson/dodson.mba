---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  showAll?: boolean;
}

const { posts, showAll = false } = Astro.props;
const displayed = showAll ? posts : posts.slice(0, 8);

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<section class="post-list">
  <div class="l-wrapper">
    <header class="post-list__header">
      <h2 class="post-list__heading">Writing</h2>
    </header>
    {displayed.length > 0 ? (
      <ol class="post-list__items">
        {displayed.map((post) => (
          <li class="post-list__item">
            <a href={`/blog/${post.id}/`} class={`post-list__link${post.data.featureImage ? ' has-thumb' : ''}`}>
              <div class="post-list__text">
                <div class="post-list__meta">
                  {post.data.tags[0] && (
                    <span class="post-list__tag">{post.data.tags[0]}</span>
                  )}
                  <span class="post-list__date">{formatDate(post.data.date)}</span>
                </div>
                <h3 class="post-list__title">{post.data.title}</h3>
                {post.data.excerpt && (
                  <p class="post-list__excerpt">{post.data.excerpt}</p>
                )}
              </div>
              {post.data.featureImage && (
                <div class="post-list__thumb">
                  <img src={post.data.featureImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="post-list__empty">No posts yet — check back soon.</p>
    )}
    {!showAll && posts.length > 8 && (
      <div class="post-list__more">
        <a href="/blog/" class="post-list__more-link">All writing &rarr;</a>
      </div>
    )}
  </div>
</section>

<style lang="scss">
  @import '../styles/common/mixins';
  @import '../styles/common/variables';

  .post-list {
    padding: 72px 0 96px;

    @include respond-to('medium') {
      padding: 96px 0 140px;
    }
  }

  .post-list__header {
    margin-bottom: 40px;
  }

  .post-list__heading {
    font-family: "Lora", serif;
    font-weight: 400;
    font-size: 0.875rem;
    letter-spacing: 0.3px;
    color: var(--titles-color);
    margin: 0;
  }

  .post-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list__item {
    border-top: 1px solid var(--primary-border-color);

    &:last-child {
      border-bottom: 1px solid var(--primary-border-color);
    }
  }

  .post-list__link {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 0;
    text-decoration: none;

    &:hover .post-list__title {
      color: var(--accent-color);
    }

    &:hover .post-list__thumb img {
      opacity: 0.8;
    }
  }

  .post-list__text {
    flex: 1;
    min-width: 0;
  }

  .post-list__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .post-list__tag {
    font-size: 0.75rem;
    letter-spacing: 0.3px;
    color: var(--accent-color);
  }

  .post-list__date {
    font-size: 0.8125rem;
    color: var(--titles-color);
    white-space: nowrap;
  }

  .post-list__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--primary-foreground-color);
    margin: 0 0 4px;
    letter-spacing: 0.2px;
    line-height: 1.35;
    @include transition(color 0.15s ease);

    @include respond-to('medium') {
      font-size: 1.1875rem;
    }
  }

  .post-list__excerpt {
    font-size: 0.9375rem;
    color: var(--titles-color);
    margin: 4px 0 0;
    line-height: 1.5;
  }

  .post-list__thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    overflow: hidden;
    background-color: var(--secondary-subtle-color);

    @include respond-to('medium') {
      width: 88px;
      height: 88px;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      @include transition(opacity 0.2s ease);
    }
  }

  .post-list__empty {
    color: var(--titles-color);
    font-size: 0.9375rem;
    padding: 32px 0;
  }

  .post-list__more {
    margin-top: 48px;
  }

  .post-list__more-link {
    font-size: 0.875rem;
    letter-spacing: 0.3px;
    color: var(--titles-color);
    text-decoration: none;
    @include transition(color 0.2s ease);

    &:hover {
      color: var(--accent-color);
    }
  }
</style>
