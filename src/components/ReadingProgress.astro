---
// Reading-progress rail. Fixed to the right edge of the viewport — deliberately away
// from the left sidebar so it reads as a separate instrument rather than part of the
// table of contents.
---

<div class="c-progress js-progress" aria-hidden="true">
  <span class="c-progress__pct js-progress-pct">0%</span>
  <span class="c-progress__track">
    <span class="c-progress__fill js-progress-fill"></span>
  </span>
</div>
