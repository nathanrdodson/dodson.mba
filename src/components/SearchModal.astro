---
// Search modal — always rendered in DOM, opened via JS
---

<div class="m-search js-search" role="dialog" aria-modal="true" aria-label="Search">
  <button class="m-icon-button outlined as-close-search js-close-search" aria-label="Close search">
    <span class="icon-close" aria-hidden="true"></span>
  </button>
  <div class="m-search__content">
    <form class="m-search__form" onsubmit="return false;">
      <div class="pos-relative">
        <span class="icon-search m-search-icon" aria-hidden="true"></span>
        <label for="search-input" class="sr-only">Type to search</label>
        <input
          id="search-input"
          type="text"
          class="m-input in-search js-input-search"
          placeholder="Type to search"
          autocomplete="off"
        />
      </div>
    </form>
    <div class="js-search-results hide"></div>
    <p class="m-not-found align-center hide js-no-results">
      No results for your search, try something different.
    </p>
  </div>
</div>
