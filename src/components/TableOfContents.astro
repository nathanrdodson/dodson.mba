---
interface Props {
  items: { id: string; label: string }[];
  label?: string;
}

const { items, label = 'Contents' } = Astro.props;
---

<nav class="c-toc" aria-label="Table of contents">
  <p class="c-toc__label" aria-hidden="true">{label}</p>
  <ul class="c-toc__list">
    {items.map(item => (
      <li>
        <a href={`#${item.id}`} class="c-toc__link" data-section={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.c-toc__link');
  const sectionEls = [...links].map(l => document.getElementById(l.dataset.section ?? ''));

  const setActive = (id: string) => {
    links.forEach(l => l.classList.toggle('is-active', l.dataset.section === id));
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { rootMargin: '-15% 0px -75% 0px', threshold: 0 });

  sectionEls.forEach(s => s && observer.observe(s));
</script>
