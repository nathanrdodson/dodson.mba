---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/app.scss';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  pageStyles?: string;
}

const {
  title = 'Nathan Dodson',
  description = 'IT Director · Platform Engineer · MBA',
  image = '/images/profile.webp',
  bodyClass = '',
  pageStyles,
} = Astro.props;

const siteTitle = 'Nathan Dodson';
const siteUrl = 'https://dodson.mba';


const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{fullTitle}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Canonical -->
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Fonts / Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/iconoir-icons/iconoir@main/css/iconoir.css" />

    <!-- Page-specific styles injected from page components -->
    {pageStyles && <style set:html={pageStyles} />}

    <!-- No-flash dark mode init — must run synchronously before paint -->
    <script is:inline>
      (function () {
        if (typeof Storage !== 'undefined') {
          var saved = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <div class="main-wrap">
      <Header />
      <slot />
    </div>

    <SearchModal />
    <Footer />

    <!-- Shared app script (Headroom, dark mode toggle, menu, search open/close) -->
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
