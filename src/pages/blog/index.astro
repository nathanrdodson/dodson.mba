---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ChronologySidebar from '../../components/ChronologySidebar.astro';
import '../../styles/listing.scss';

const allPosts = await getCollection('blog', (e: CollectionEntry<'blog'>) => !e.data.draft);
allPosts.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.getTime() - a.data.date.getTime()
);

const yearGroups = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of allPosts) {
  const year = post.data.date.getFullYear();
  const group = yearGroups.get(year);
  if (group) {
    group.push(post);
  } else {
    yearGroups.set(year, [post]);
  }
}

const years = [...yearGroups.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([year, posts]) => ({ year, posts, count: posts.length }));
---

<BaseLayout title="Writing" description="Articles and thoughts by Nathan Dodson">
  <main>
    <div class="l-content in-blog-listing">
      <div class="l-wrapper">
        <header class="blog-listing-header" data-animate="fade-up">
          <h1 class="blog-listing-header__title">Writing</h1>
        </header>

        {years.length > 0 ? (
          <div class="l-blog-body" data-animate="fade-up">
            <ChronologySidebar years={years.map(({ year, count }) => ({ year, count }))} />

            <div class="l-blog-body__content">
              {years.map(({ year, posts }) => (
                <section class="blog-year-group" id={`y${year}`}>
                  <h2 class="blog-year-heading">{year}</h2>
                  <div class="m-articles-grid l-grid">
                    {posts.map((post: CollectionEntry<'blog'>) => (
                      <ArticleCard post={post} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        ) : (
          <div class="m-heading no-margin">
            <h3>No posts yet.</h3>
            <p>Check back soon.</p>
          </div>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  @import '../../styles/common/mixins';
  @import '../../styles/common/variables';

  .in-blog-listing {
    padding-top: 0;
  }

  .blog-listing-header {
    padding: 80px 0 48px;
    border-bottom: 1px solid var(--primary-border-color);
    margin-bottom: 48px;

    @include respond-to('medium') {
      padding: 120px 0 56px;
    }
  }

  .blog-listing-header__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: 0.3px;
    color: var(--primary-foreground-color);
    margin: 0;
  }
</style>
