---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/career.scss';

const sections = [
  { id: 'work-experience', label: 'Work Experience' },
  { id: 'education', label: 'Education' },
  { id: 'technical-skills', label: 'Skills' },
  { id: 'projects', label: 'Projects' },
  { id: 'earlier-experience', label: 'Earlier' },
  { id: 'leadership', label: 'Leadership' },
];
---

<BaseLayout
  title="Experience"
  description="Work history, education, and skills for Nathan Dodson — IT Director, Platform Engineer, MBA."
  bodyClass="is-career"
>
  <main>
    <div class="l-content">
      <div class="l-wrapper">
        <div class="c-career" data-animate="fade-up">
          <header class="c-career__header">
            <h1 class="c-career__pagetitle">Professional Experience</h1>
            <p class="c-career__whois">Nathan Dodson / IT Director / Platform Engineer / MBA</p>
            <ul class="c-actions">
              <li>
                <a href="/files/resume.pdf" download class="c-btn-solid" aria-label="Download resume PDF">
                  <i class="iconoir-download" aria-hidden="true"></i>
                  Download resume
                </a>
              </li>
              <li><a href="mailto:nrdod@icloud.com" class="c-chip">nrdod@icloud.com</a></li>
              <li>
                <a href="https://linkedin.com/in/nathanrdodson" class="c-chip" target="_blank" rel="noopener">
                  <i class="iconoir-linkedin" aria-hidden="true"></i>
                  linkedin.com/in/nathanrdodson
                </a>
              </li>
              <li>
                <a href="https://github.com/nathanrdodson" class="c-chip" target="_blank" rel="noopener">
                  <i class="iconoir-github" aria-hidden="true"></i>
                  github.com/nathanrdodson
                </a>
              </li>
            </ul>
          </header>

          <div class="c-career__body">
            <aside class="c-side">
              <TableOfContents items={sections} />
            </aside>
            <div class="c-career__content">
              <CareerTimeline />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
