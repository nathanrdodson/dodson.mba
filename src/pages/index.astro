---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PostList from '../components/PostList.astro';
import { hashString } from '../lib/seed';

const allPosts = await getCollection('blog', (e: CollectionEntry<'blog'>) => !e.data.draft);
const posts = allPosts.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.getTime() - a.data.date.getTime()
);

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Render about/index.md for the bio slot
const aboutEntries = await getCollection('about');
const aboutEntry = aboutEntries[0];
const { Content: Bio } = aboutEntry ? await render(aboutEntry) : { Content: null };

// Crop-mark overhangs, seeded per photo so all four sides differ and no two frames
// match — the marks read as struck by hand rather than mechanically centred. Stable
// across rebuilds because it's derived from the entry id.
//
// Collision budget: a hovered frame extends to MAX_OVERHANG + HOVER_GROWTH while its
// neighbour sits at up to MAX_OVERHANG, so the grid gap must exceed the sum of the
// two. 26 + 14 + 26 = 66 against a 72px gutter, which can never touch.
const OVERHANG = [8, 14, 20, 26];

function cropMarks(id: string) {
  const s = hashString(id);
  const pick = (shift: number) => OVERHANG[(s >> shift) % OVERHANG.length];
  return { t: pick(0), b: pick(3), l: pick(6), r: pick(9) };
}
---

<BaseLayout title="Nathan Dodson" bodyClass="is-home">
  <main>
    <HomeHero>
      {Bio ? <Bio /> : <p>IT Manager based in Kansas City.</p>}
    </HomeHero>

    <PostList posts={posts} />

    {photos.length > 0 && (
      <section class="home-photos">
        <div class="l-wrapper">
          <header class="home-photos__header">
            <h2 class="home-photos__heading">Photos</h2>
            <a href="/photos/" class="c-chip">
              All albums
              <i class="iconoir-arrow-right" aria-hidden="true"></i>
            </a>
          </header>
          <div class="home-photos__row">
            {photos.map((photo) => {
              const m = cropMarks(photo.id);
              return (
                <a href={`/photos/${photo.id}/`} class="home-photos__item" aria-label={photo.data.title}>
                  <span
                    class="home-photos__frame"
                    style={`--mk-t:${m.t}px;--mk-b:${m.b}px;--mk-l:${m.l}px;--mk-r:${m.r}px;`}
                  >
                    <img
                      src={photo.data.featureImage}
                      alt={photo.data.featureImageAlt || photo.data.title}
                      loading="lazy"
                    />
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <script>
    import '../scripts/home-keys';
  </script>
</BaseLayout>

<style lang="scss">
  @import '../styles/common/mixins';
  @import '../styles/common/variables';

  .home-photos {
    // Matches the Writing section's rhythm.
    padding-top: clamp(96px, 15vh, 200px);
    padding-bottom: 96px;
  }

  .home-photos__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .home-photos__heading {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: clamp(1.875rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--primary-foreground-color);
    margin: 0;
  }

  // "All albums" uses the shared .c-chip primitive.

  .home-photos__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    // Must exceed max-overhang + hover-growth + max-overhang (26+14+26 = 66).
    gap: 72px;

    @media (max-width: 32rem) {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      // Scales every overhang down so the same guarantee holds in the tighter gutter:
      // (26+14)*0.45 + 26*0.45 = 29.7 against 32px.
      --mk-scale: 0.45;

      :global(:nth-child(3)) {
        display: none;
      }
    }
  }

  .home-photos__item {
    display: block;
  }

  // Crop marks — two pseudo-elements whose rules cross and overshoot at all four
  // corners, like a press proof. No extra DOM, no rounded corners, no shadow.
  .home-photos__frame {
    position: relative;
    display: block;

    &::before,
    &::after {
      content: '';
      position: absolute;
      pointer-events: none;
      border-style: solid;
      border-color: var(--primary-foreground-color);
      border-width: 0;

      // Length only — thickness stays at 1px throughout.
      transition: top 0.34s cubic-bezier(0.4, 0, 0.2, 1),
        bottom 0.34s cubic-bezier(0.4, 0, 0.2, 1),
        left 0.34s cubic-bezier(0.4, 0, 0.2, 1),
        right 0.34s cubic-bezier(0.4, 0, 0.2, 1);
    }

    // Vertical rules — top and bottom overhang differ, seeded per photo.
    &::before {
      top: calc(var(--mk-t, 12px) * var(--mk-scale, 1) * -1);
      bottom: calc(var(--mk-b, 12px) * var(--mk-scale, 1) * -1);
      left: 0;
      right: 0;
      border-left-width: 1px;
      border-right-width: 1px;
    }

    // Horizontal rules — left and right overhang differ, seeded per photo.
    &::after {
      left: calc(var(--mk-l, 12px) * var(--mk-scale, 1) * -1);
      right: calc(var(--mk-r, 12px) * var(--mk-scale, 1) * -1);
      top: 0;
      bottom: 0;
      border-top-width: 1px;
      border-bottom-width: 1px;
    }

    img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background-color: var(--secondary-subtle-color);
    }
  }

  // Hover draws every overhang further out. Length is the only thing that changes —
  // weight and colour hold — so the photo sits still while the marks extend past it.
  .home-photos__item:hover .home-photos__frame,
  .home-photos__item:focus-visible .home-photos__frame {
    &::before {
      top: calc((var(--mk-t, 12px) + 14px) * var(--mk-scale, 1) * -1);
      bottom: calc((var(--mk-b, 12px) + 14px) * var(--mk-scale, 1) * -1);
    }

    &::after {
      left: calc((var(--mk-l, 12px) + 14px) * var(--mk-scale, 1) * -1);
      right: calc((var(--mk-r, 12px) + 14px) * var(--mk-scale, 1) * -1);
    }
  }
</style>
