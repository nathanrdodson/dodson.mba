---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('blog', (e: CollectionEntry<'blog'>) => !e.data.draft);
const posts = allPosts.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.getTime() - a.data.date.getTime()
);

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Render about/index.md for the bio slot
const aboutEntries = await getCollection('about');
const aboutEntry = aboutEntries[0];
const { Content: Bio } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<BaseLayout title="Nathan Dodson" bodyClass="is-home">
  <main>
    <HomeHero>
      {Bio ? <Bio /> : <p>IT Manager based in Kansas City.</p>}
    </HomeHero>

    {photos.length > 0 && (
      <section class="home-photos">
        <div class="l-wrapper">
          <header class="home-photos__header">
            <h2 class="home-photos__heading">Photos</h2>
            <a href="/photos/" class="home-photos__all">All albums &rarr;</a>
          </header>
          <div class="home-photos__row">
            {photos.map((photo) => (
              <a href={`/photos/${photo.id}/`} class="home-photos__item">
                <div class="home-photos__img-wrap">
                  <img
                    src={photo.data.featureImage}
                    alt={photo.data.featureImageAlt || photo.data.title}
                    loading="lazy"
                  />
                </div>
                <span class="home-photos__label">{photo.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <PostList posts={posts} />
  </main>
</BaseLayout>

<style lang="scss">
  @import '../styles/common/mixins';
  @import '../styles/common/variables';

  .home-photos {
    padding: 64px 0;
    border-bottom: 1px solid var(--primary-border-color);

    @include respond-to('medium') {
      padding: 80px 0;
    }
  }

  .home-photos__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .home-photos__heading {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: 0.3px;
    color: var(--primary-foreground-color);
    margin: 0;
  }

  .home-photos__all {
    font-size: 0.8125rem;
    letter-spacing: 1px;
    color: var(--titles-color);
    text-decoration: none;
    @include transition(color 0.2s ease);

    &:hover {
      color: var(--accent-color);
    }
  }

  .home-photos__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;

    @media (max-width: 500px) {
      grid-template-columns: 1fr 1fr;

      :global(:nth-child(3)) {
        display: none;
      }
    }
  }

  .home-photos__item {
    display: block;
    text-decoration: none;

    &:hover .home-photos__img-wrap img {
      opacity: 0.75;
    }

    &:hover .home-photos__label {
      color: var(--accent-color);
    }
  }

  .home-photos__img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--secondary-subtle-color);
    margin-bottom: 10px;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      @include transition(opacity 0.2s ease);
    }
  }

  .home-photos__label {
    font-size: 0.8125rem;
    color: var(--titles-color);
    letter-spacing: 0.3px;
    @include transition(color 0.2s ease);
  }
</style>
